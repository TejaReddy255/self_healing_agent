{
  "$defs": {
    "AnalysisSummary": {
      "additionalProperties": false,
      "properties": {
        "affected_resource": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Resource"
        },
        "affected_system": {
          "anyOf": [
            {
              "$ref": "#/$defs/SystemName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dag_id": {
          "maxLength": 250,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*$",
          "title": "Dag Id",
          "type": "string"
        },
        "error_details": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Details"
        },
        "impact": {
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "pipeline_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipeline Id"
        },
        "root_cause": {
          "minLength": 1,
          "title": "Root Cause",
          "type": "string"
        },
        "run_id": {
          "maxLength": 250,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 250,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "dag_id",
        "run_id",
        "root_cause",
        "impact"
      ],
      "title": "AnalysisSummary",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "CountExpectation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "op",
        "value"
      ],
      "title": "CountExpectation",
      "type": "object"
    },
    "DQRuleRef": {
      "additionalProperties": false,
      "description": "Reference to a governed business rule (src §33.5), e.g. ``BR-CUST-002``.",
      "properties": {
        "rule_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_set_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Set Id"
        }
      },
      "required": [
        "rule_id"
      ],
      "title": "DQRuleRef",
      "type": "object"
    },
    "DocumentCountAssertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expected": {
          "$ref": "#/$defs/CountExpectation"
        },
        "filter": {
          "additionalProperties": true,
          "title": "Filter",
          "type": "object"
        },
        "kind": {
          "const": "document_count",
          "title": "Kind",
          "type": "string"
        },
        "resource": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "kind",
        "resource",
        "expected"
      ],
      "title": "DocumentCountAssertion",
      "type": "object"
    },
    "DuplicateCountAssertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expected": {
          "$ref": "#/$defs/CountExpectation"
        },
        "key_columns": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Key Columns",
          "type": "array"
        },
        "kind": {
          "const": "duplicate_count",
          "title": "Kind",
          "type": "string"
        },
        "resource": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "kind",
        "resource",
        "key_columns",
        "expected"
      ],
      "title": "DuplicateCountAssertion",
      "type": "object"
    },
    "EvidenceStatus": {
      "description": "Evidence labels from the shared evidence policy (src §6.1).",
      "enum": [
        "OBSERVED",
        "VERIFIED",
        "INFERRED",
        "PROPOSED",
        "EXECUTED",
        "VERIFIED_FIXED"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "ExistsExpectation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "eq",
          "default": "eq",
          "title": "Op",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "value"
      ],
      "title": "ExistsExpectation",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "evidence_status",
        "severity"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ObjectCountAssertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "bucket": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Bucket",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expected": {
          "$ref": "#/$defs/CountExpectation"
        },
        "kind": {
          "const": "object_count",
          "title": "Kind",
          "type": "string"
        },
        "prefix": {
          "default": "",
          "title": "Prefix",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "kind",
        "bucket",
        "expected"
      ],
      "title": "ObjectCountAssertion",
      "type": "object"
    },
    "ObjectExistsAssertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "bucket": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Bucket",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expected": {
          "$ref": "#/$defs/ExistsExpectation"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "object_exists",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "kind",
        "bucket",
        "key",
        "expected"
      ],
      "title": "ObjectExistsAssertion",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "priority": {
          "exclusiveMinimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "requires_human_approval": {
          "title": "Requires Human Approval",
          "type": "boolean"
        }
      },
      "required": [
        "priority",
        "action",
        "rationale",
        "requires_human_approval"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "RemediationPlan": {
      "additionalProperties": false,
      "properties": {
        "expected_write_operations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Expected Write Operations",
          "type": "array"
        },
        "max_affected_rows": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Affected Rows"
        },
        "precondition_assertions": {
          "items": {
            "discriminator": {
              "mapping": {
                "document_count": "#/$defs/DocumentCountAssertion",
                "duplicate_count": "#/$defs/DuplicateCountAssertion",
                "object_count": "#/$defs/ObjectCountAssertion",
                "object_exists": "#/$defs/ObjectExistsAssertion",
                "row_count": "#/$defs/RowCountAssertion",
                "sql_scalar": "#/$defs/SqlScalarAssertion"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DuplicateCountAssertion"
              },
              {
                "$ref": "#/$defs/RowCountAssertion"
              },
              {
                "$ref": "#/$defs/SqlScalarAssertion"
              },
              {
                "$ref": "#/$defs/ObjectExistsAssertion"
              },
              {
                "$ref": "#/$defs/ObjectCountAssertion"
              },
              {
                "$ref": "#/$defs/DocumentCountAssertion"
              }
            ]
          },
          "title": "Precondition Assertions",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "retry_airflow_after_success": {
          "default": true,
          "title": "Retry Airflow After Success",
          "type": "boolean"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "steps": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Stop Conditions",
          "type": "array"
        },
        "target_resources": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Resources",
          "type": "array"
        },
        "target_system": {
          "$ref": "#/$defs/SystemName"
        },
        "verification_plan": {
          "$ref": "#/$defs/VerificationPlan"
        },
        "verification_rules": {
          "items": {
            "$ref": "#/$defs/DQRuleRef"
          },
          "title": "Verification Rules",
          "type": "array"
        },
        "write_tools": {
          "anyOf": [
            {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Write Tools"
        }
      },
      "required": [
        "target_system",
        "risk_level",
        "verification_plan"
      ],
      "title": "RemediationPlan",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "RowCountAssertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expected": {
          "$ref": "#/$defs/CountExpectation"
        },
        "kind": {
          "const": "row_count",
          "title": "Kind",
          "type": "string"
        },
        "resource": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "kind",
        "resource",
        "expected"
      ],
      "title": "RowCountAssertion",
      "type": "object"
    },
    "SOPMatchStatus": {
      "enum": [
        "MATCHED",
        "NO_MATCH",
        "PARTIAL"
      ],
      "title": "SOPMatchStatus",
      "type": "string"
    },
    "SOPProposal": {
      "additionalProperties": false,
      "description": "A generated SOP (W3). Installed only when the review containing it is approved (ADR-008).",
      "properties": {
        "category": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "human_approval_required": {
          "const": true,
          "default": true,
          "title": "Human Approval Required",
          "type": "boolean"
        },
        "remediation_steps": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Remediation Steps",
          "type": "array"
        },
        "required_evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Evidence",
          "type": "array"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "stop_conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Stop Conditions",
          "type": "array"
        },
        "target_system": {
          "$ref": "#/$defs/SystemName"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "verification_steps": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Verification Steps",
          "type": "array"
        }
      },
      "required": [
        "title",
        "category",
        "target_system",
        "risk_level",
        "remediation_steps"
      ],
      "title": "SOPProposal",
      "type": "object"
    },
    "SOPReference": {
      "additionalProperties": false,
      "description": "Pins the approved SOP (and version, when catalogued) that a plan follows.",
      "properties": {
        "sop_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Sop Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "sop_id"
      ],
      "title": "SOPReference",
      "type": "object"
    },
    "ScalarExpectation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "op",
        "value"
      ],
      "title": "ScalarExpectation",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "INFO",
        "WARNING",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SqlScalarAssertion": {
      "additionalProperties": false,
      "description": "A single-value read-only query (validated read-only before execution, S19).",
      "properties": {
        "assertion_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Assertion Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expected": {
          "$ref": "#/$defs/ScalarExpectation"
        },
        "kind": {
          "const": "sql_scalar",
          "title": "Kind",
          "type": "string"
        },
        "sql": {
          "minLength": 1,
          "title": "Sql",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "kind",
        "sql",
        "expected"
      ],
      "title": "SqlScalarAssertion",
      "type": "object"
    },
    "SystemName": {
      "enum": [
        "postgresql",
        "mysql",
        "s3",
        "mongodb"
      ],
      "title": "SystemName",
      "type": "string"
    },
    "VerificationPlan": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "items": {
            "discriminator": {
              "mapping": {
                "document_count": "#/$defs/DocumentCountAssertion",
                "duplicate_count": "#/$defs/DuplicateCountAssertion",
                "object_count": "#/$defs/ObjectCountAssertion",
                "object_exists": "#/$defs/ObjectExistsAssertion",
                "row_count": "#/$defs/RowCountAssertion",
                "sql_scalar": "#/$defs/SqlScalarAssertion"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DuplicateCountAssertion"
              },
              {
                "$ref": "#/$defs/RowCountAssertion"
              },
              {
                "$ref": "#/$defs/SqlScalarAssertion"
              },
              {
                "$ref": "#/$defs/ObjectExistsAssertion"
              },
              {
                "$ref": "#/$defs/ObjectCountAssertion"
              },
              {
                "$ref": "#/$defs/DocumentCountAssertion"
              }
            ]
          },
          "title": "Assertions",
          "type": "array"
        }
      },
      "title": "VerificationPlan",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "additional_investigation_needed": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Additional Investigation Needed",
      "type": "array"
    },
    "analysis_confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "detailed_findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Detailed Findings",
      "type": "array"
    },
    "fixes_applied": {
      "default": false,
      "title": "Fixes Applied",
      "type": "boolean"
    },
    "matched_sop_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/SOPReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pipeline_status": {
      "default": "unknown",
      "enum": [
        "unknown",
        "failed",
        "remediated",
        "blocked"
      ],
      "title": "Pipeline Status",
      "type": "string"
    },
    "prevention_measures": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Prevention Measures",
      "type": "array"
    },
    "proposed_remediation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemediationPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "proposed_sop": {
      "anyOf": [
        {
          "$ref": "#/$defs/SOPProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/Recommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "sop_match_status": {
      "$ref": "#/$defs/SOPMatchStatus"
    },
