{
  "$defs": {
    "Checkpoint": {
      "enum": [
        "SOURCE",
        "STAGING",
        "TARGET",
        "RECONCILIATION",
        "SCHEDULED"
      ],
      "title": "Checkpoint",
      "type": "string"
    },
    "DQAgentName": {
      "description": "Logical DQ agent names (architecture §18 C9).",
      "enum": [
        "custom_dq",
        "recon",
        "profiling",
        "statistical",
        "anomaly",
        "preprocessing"
      ],
      "title": "DQAgentName",
      "type": "string"
    },
    "DQAgentResult": {
      "additionalProperties": false,
      "description": "One agent/rule outcome at a checkpoint, as persisted in ``dq_results`` (S17).",
      "properties": {
        "actual": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "agent": {
          "$ref": "#/$defs/DQAgentName"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "checkpoint": {
          "$ref": "#/$defs/Checkpoint"
        },
        "dq_service_job_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dq Service Job Id"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "expected": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "failed_row_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed Row Count"
        },
        "message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "report_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Ref"
        },
        "result_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Id"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "status": {
          "$ref": "#/$defs/DQStatus"
        }
      },
      "required": [
        "agent",
        "checkpoint",
        "status",
        "blocking",
        "evaluated_at"
      ],
      "title": "DQAgentResult",
      "type": "object"
    },
    "DQStatus": {
      "enum": [
        "PASS",
        "WARNING",
        "CRITICAL",
        "ERROR"
      ],
      "title": "DQStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Aggregated outcome of one checkpoint run.",
  "properties": {
    "checkpoint": {
      "$ref": "#/$defs/Checkpoint"
    },
    "dq_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dq Run Id"
    },
    "error": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "pipeline_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-]*$",
      "title": "Pipeline Id",
      "type": "string"
    },
    "request_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Request Key",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/DQAgentResult"
      },
      "title": "Results",
      "type": "array"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 250,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DQStatus"
    }
  },
  "required": [
    "request_key",
    "pipeline_id",
    "checkpoint",
    "status",
    "results",
    "started_at"
  ],
  "title": "DQRunResult",
  "type": "object"
}
