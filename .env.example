# Copy to .env for local development. Never commit .env. Secrets have no defaults on purpose.

# --- Control plane (backend) ---------------------------------------------------------------
# dev | test | prod
ENV=dev
LOG_LEVEL=INFO
# JSON list of allowed browser origins; wildcard "*" is rejected when ENV=prod.
CORS_ALLOW_ORIGINS=[]
# Token file: {"<sha256 of token>": {"subject": "...", "role": "viewer|operator|reviewer|admin|service"}}
# Create entries with:  uv run python tools/new_token.py <subject> <role>
API_TOKENS_FILE=config/api_tokens.json
# Alternatively the same JSON inline (secret):
# API_TOKENS=

# --- Operator console (frontend) -----------------------------------------------------------
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_API_TOKEN=
AGENT_HEALTH_TIMEOUT_SECONDS=5

# --- Operational PostgreSQL (deploy/docker-compose.dev.yml) --------------------------------
# 55432 avoids clashing with a locally installed PostgreSQL on 5432.
PG_HOST=127.0.0.1
PG_PORT=55432
PG_USER=selfhealing
PG_DATABASE=selfhealing
PG_PASSWORD=
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000
# DDL lock wait for migrations (the migration CLI has no statement timeout).
PG_MIGRATION_LOCK_TIMEOUT_MS=5000
AUDIT_MAX_PAYLOAD_BYTES=65536

# --- Static metadata (S04) ---
# Directory of version-controlled pipeline knowledge. Default: <repo>/metadata.
# METADATA_DIR=metadata
METADATA_MAX_FILE_BYTES=1048576
# Every process checks for changed metadata this often and swaps in valid changes; 0 disables.
METADATA_REFRESH_INTERVAL_S=30

# --- Airflow 2.x REST API (S05) ---
# Unset AIRFLOW_BASE_URL = not configured (allowed outside prod). prod requires https and credentials.
AIRFLOW_BASE_URL=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_API_VERSION=v1
AIRFLOW_CONNECT_TIMEOUT_S=5
AIRFLOW_READ_TIMEOUT_S=30
AIRFLOW_GET_RETRIES=3
AIRFLOW_LOG_MAX_CHARS=20000
AIRFLOW_LOG_MAX_DOWNLOAD_BYTES=2097152
AIRFLOW_LOG_DOWNLOAD_CEILING_BYTES=33554432
AIRFLOW_CONTEXT_RUN_LIMIT=5
RECOVERY_POLL_SECONDS=30

# --- MCP servers and tool permissions (S06) ---
# Per system (POSTGRESQL, MYSQL, S3, MONGODB): MCP_<SYSTEM>_URL / _ENABLED / _REQUIRED / _MODULE
MCP_POSTGRESQL_URL=http://127.0.0.1:8001/mcp
MCP_MYSQL_URL=http://127.0.0.1:8002/mcp
MCP_S3_URL=http://127.0.0.1:8003/mcp
MCP_MONGODB_URL=http://127.0.0.1:8004/mcp
# Start unreachable local servers (literal 127.0.0.1/::1 URLs only) as `python -m mcp_servers.<name>`.
# Refused in prod. Children get only OS basics and MCP_* variables, never other credentials.
MCP_AUTOSTART=false
MCP_DEFAULT_TIMEOUT_S=60
MCP_MAX_OUTPUT_BYTES=8192
MCP_PROBE_TIMEOUT_S=3
MCP_REFRESH_INTERVAL_S=60
MCP_READ_RETRIES=2
# Default: <repo>/config/tool_permissions.yaml (missing or invalid = startup fails)
# TOOL_PERMISSIONS_FILE=config/tool_permissions.yaml

# --- Database MCP servers and dev data containers (S07) ---
# Containers: sales-db (MySQL, source) and warehouse-db (PostgreSQL, target) in
# deploy/docker-compose.dev.yml. Init scripts create the reader/writer roles from these passwords.
# 13306 and 55433 avoid Windows' excluded port ranges and a local PostgreSQL on 5432.
MYSQL_PORT=13306
WAREHOUSE_PG_PORT=55433
MYSQL_ROOT_PASSWORD=
WAREHOUSE_PG_PASSWORD=
MCP_POSTGRES_READER_PASSWORD=
MCP_POSTGRES_WRITER_PASSWORD=
MCP_MYSQL_READER_PASSWORD=
MCP_MYSQL_WRITER_PASSWORD=
# Servers: python -m mcp_servers.postgres (port 8001) / python -m mcp_servers.mysql (port 8002).
# Reader DSN: SELECT-only role, read-only transactions. Leave a WRITER DSN empty and that server
# exposes no write tools. URL-encode special characters in passwords.
MCP_POSTGRES_READER_DSN=postgresql://mcp_reader:<password>@127.0.0.1:55433/warehouse
MCP_POSTGRES_WRITER_DSN=
MCP_MYSQL_READER_DSN=mysql://mcp_reader:<password>@127.0.0.1:13306/sales
MCP_MYSQL_WRITER_DSN=
# MCP_POSTGRES_SCHEMAS=["dw"]
# MCP_MYSQL_SCHEMAS=["sales"]
# MCP_BIND_HOST=127.0.0.1
# Result rows per tool call (NFR-006), statement timeout, and the hard ceiling for execute_dml.
MCP_ROW_LIMIT=20
MCP_STATEMENT_TIMEOUT_MS=30000
MCP_MAX_AFFECTED_ROWS=10000
# Columns run_select refuses to reference; describe_table flags them; find_duplicates masks them.
MCP_PII_COLUMNS=["dw.customer.email","dw.customer.phone","sales.customer.email","sales.customer.phone"]
# Seed the canonical scenario (drops and recreates the tables):
#   uv run python deploy/seed/canonical.py --rows 100000 --duplicates 417
